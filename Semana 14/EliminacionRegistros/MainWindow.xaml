<Window x:Class="EliminacionRegistros.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EliminacionRegistros"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,0,0,10">

                <TextBlock Text="ID Categoría:"
                   Width="120"/>

                <TextBox x:Name="txtIdCategoria"
                 Width="200" IsReadOnly="True"/>
            </StackPanel>
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Nombre: " Width="120"/>
                    <TextBox x:Name="txtNombre" Width="200"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Descripcioón: " Width="120"/>
                    <TextBox x:Name="txtDescripcion" Width="200"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnNuevo" Content="Nuevo" Margin="0,0,10,0" Width="100" Click="btnNuevo_Click" />
                    <Button x:Name="btnAgregar" Content="Guardar" Padding="0,5,0,5" Width="100" Click="btnAgregar_Click" />
                    <Button x:Name="btnEliminar" Content="Eliminar" Margin="10,0,0,0" IsEnabled="False" Width="100" Click="btnEliminar_Click" />
                </StackPanel>

            </Grid>

        </StackPanel>

        <DataGrid x:Name="dgCategorias" Grid.Row="1" IsReadOnly="True" SelectionChanged="dgCategorias_SelectionChanged"/>

    </Grid>
</Window>