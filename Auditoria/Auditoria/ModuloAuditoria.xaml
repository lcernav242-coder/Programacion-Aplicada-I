<Window x:Class="Auditoria.ModuloAuditoria"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Módulo de Auditoría de Envíos" Height="600" Width="800" Background="#F0F0F0">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="15" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock Text="Transportista:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="cbTransportistas" Width="180" DisplayMemberPath="CompanyName" SelectedValuePath="ShipperID" Margin="0,0,20,0"/>

                <TextBlock Text="Flete Min ($):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="txtFleteMin" Width="70" Margin="0,0,15,0" Padding="2"/>

                <TextBlock Text="Flete Max ($):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="txtFleteMax" Width="70" Margin="0,0,20,0" Padding="2"/>

                <Button x:Name="btnBuscar" Content="Buscar Pedidos" Padding="15,5" Click="btnBuscar_Click"/>

            </StackPanel>
        </Border>

        <DataGrid x:Name="dgPedidos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="White" RowBackground="#FAFAFA" AlternatingRowBackground="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Número de Orden" Binding="{Binding NumeroOrden}" Width="120"/>
                <DataGridTextColumn Header="Nombre del Cliente" Binding="{Binding NombreCliente}" Width="*"/>
                <DataGridTextColumn Header="Fecha de Pedido" Binding="{Binding FechaPedido, StringFormat=dd/MM/yyyy}" Width="120"/>
                <DataGridTextColumn Header="Monto del Flete" Binding="{Binding MontoFlete, StringFormat=C2}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="#E0E0E0" Padding="15" BorderBrush="Gray" BorderThickness="1" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <TextBlock Text="Total Pedidos: " FontWeight="Bold" FontSize="14"/>
                <TextBlock x:Name="lblCantidad" Text="0" FontSize="14" Margin="0,0,30,0"/>

                <TextBlock Text="Monto Total Fletes: " FontWeight="Bold" FontSize="14"/>
                <TextBlock x:Name="lblMontoTotal" Text="$0.00" FontSize="14" Margin="0,0,30,0" Foreground="DarkBlue"/>

                <TextBlock Text="Promedio de Flete: " FontWeight="Bold" FontSize="14"/>
                <TextBlock x:Name="lblPromedio" Text="$0.00" FontSize="14" Foreground="DarkGreen"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>