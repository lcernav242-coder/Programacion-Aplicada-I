<Window x:Class="MantenimientoLibros.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MantenimientoLibros.ViewModels"
        Title="Mantenimiento de Libros - EditorialDB" Width="1400" Height="850"
        MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Background="#FFF6F3F4" FontFamily="Segoe UI" FontSize="13">
    
    <Window.DataContext>
        <vm:LibroViewModel />
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#A63254"/>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="BorderBrush" Value="#D7CAD1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="BorderBrush" Value="#D7CAD1"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#74374E"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="22,9"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="106"/>
            <Setter Property="Background" Value="#F1E8ED"/>
            <Setter Property="Foreground" Value="#56283A"/>
            <Setter Property="BorderBrush" Value="#CCB7C0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="HeaderCell" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,9"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- FORMULARIO -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" BorderBrush="#E2D5DB"
                BorderThickness="1" Margin="5" Padding="15,12">
            <StackPanel>
                <TextBlock Text="Mantenimiento de Libros" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                           Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Código (title_id) *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding LibroActual.TitleId, UpdateSourceTrigger=PropertyChanged}" MaxLength="6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Título del libro (title) *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding LibroActual.Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Fecha publicación *" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding LibroActual.PubDate}"/>
                    </StackPanel>
                </Grid>
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Tipo de publicación (type) *" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding LibroActual.Type, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Editorial (pub_id)" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding ListaEditoriales}" SelectedValuePath="PubId" DisplayMemberPath="PubName"
                                  SelectedValue="{Binding LibroActual.PubId}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Precio (price)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding LibroActual.Price, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Anticipo (advance)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding LibroActual.Advance, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Regalías %" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding LibroActual.Royalty, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="8">
                        <TextBlock Text="Ventas año" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding LibroActual.YtdSales, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Notas (notes)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding LibroActual.Notes, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="200" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Autores asignados (relación N:M titleauthor)" Style="{StaticResource FieldLabel}"/>
                        <ListBox ItemsSource="{Binding ListaAutores}" Height="80" Margin="0,5,0,0" BorderBrush="#D7CAD1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding NombreCompleto}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="4,2"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>

                <DockPanel Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="* Campos obligatorios"
                               Foreground="#806D79" VerticalAlignment="Center"/>
                    <WrapPanel>
                        <Button Content="Nuevo" Command="{Binding NuevoCommand}" Style="{StaticResource ActionButton}"/>
                        <Button Content="Guardar" Command="{Binding GuardarCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Cancelar" Command="{Binding CancelarCommand}" Style="{StaticResource ActionButton}"/>
                        <Button Content="Eliminar" Command="{Binding EliminarCommand}" Style="{StaticResource ActionButton}"/>
                    </WrapPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- DATAGRID -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#E2D5DB"
                BorderThickness="1" Margin="5,0,5,5" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Libros registrados" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding ListaLibros}"
                          SelectedItem="{Binding LibroActual, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                          BorderBrush="#E0D4DA" ColumnHeaderStyle="{StaticResource HeaderCell}"
                          AlternatingRowBackground="#FFF7F3F5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código (title_id)" Binding="{Binding TitleId}" Width="110"/>
                        <DataGridTextColumn Header="Título del libro" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="110"/>
                        <DataGridTextColumn Header="Editorial" Binding="{Binding PubName}" Width="160"/>
                        <DataGridTextColumn Header="Ciudad Editorial" Binding="{Binding City}" Width="130"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="80"/>
                        <DataGridTextColumn Header="Fecha Pub." Binding="{Binding PubDate, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                        <DataGridTextColumn Header="Ventas Totales" Binding="{Binding YtdSales}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- PIE DE PÁGINA -->
        <Border Grid.Row="2" Background="#FBE7EE" Padding="10,8" Margin="5,0,5,5" CornerRadius="4">
            <TextBlock Text="Sistema de Mantenimiento MVVM - Conexión establecida con EditorialDB" Foreground="#702B43" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>